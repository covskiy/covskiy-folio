{
  "name": "covskiy-folio",
  "version": "0.1.0",
  "private": true,
  "description": "Сайт-визитка (MPA на Vite) + Vercel Function: вебчат и Telegram-бот на едином «мозге»-справочнике",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vercel": "^65.10.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
